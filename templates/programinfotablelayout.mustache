<div class="programbox clearfix" data-programid="{{programid}}">
    <div class="programimage float-end">
        <img src="{{thumbnail}}" alt="{{fullname}}" />
    </div>
    <div class="info">
        <h2 class="programname">{{{programicon}}}{{{fullname}}}</h2>
    </div>{{{tagsdiv}}}
    <div class="content">
        <div class="summary">{{{description}}}</div>
    </div>
</div>
{{> enrol_programs/programallocation_user }}
