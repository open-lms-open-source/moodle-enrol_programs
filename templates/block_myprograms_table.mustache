<div class="table-responsive">
    <table id="my_programs" class="admintable generaltable">
        <thead>
            <tr>
                <th>{{#str}}programname, enrol_programs{{/str}}</th>
                <th>{{#str}}programidnumber, enrol_programs{{/str}}</th>
                {{#ismyprogramspage}}<th>{{#str}}description, moodle{{/str}}</th>{{/ismyprogramspage}}
                <th>{{#str}}programstatus, enrol_programs{{/str}}</th>
                <th>{{#str}}source, enrol_programs{{/str}}</th>
                <th>{{#str}}programstart, enrol_programs{{/str}}</th>
                <th>{{#str}}programdue, enrol_programs{{/str}}</th>
                <th>{{#str}}programend, enrol_programs{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#programs}}
                <tr>
                    <td>{{{fullname}}}</td>
                    <td>{{idnumber}}</td>
                    {{#ismyprogramspage}}<td class="program-desc">{{{description}}}</td>{{/ismyprogramspage}}
                    <td>{{{status}}}</td>
                    <td>{{{source}}}</td>
                    <td>{{programstart}}</td>
                    <td>{{programdue}}</td>
                    <td>{{programend}}</td>
                </tr>
           {{/programs}}
        </tbody>
    </table>
</div>