<div class="col-md-4">
    <div class="card course-card m-1 position-relative {{#disabled}} bg-light text-muted disabled {{/disabled}}" {{#disabled}} aria-disabled="true" {{/disabled}}>
        <img class="card-img-top" src="{{image}}" alt="{{fullname}}">
        {{#sequencerequired}}
            <span class="badge rounded-circle bg-light p-3 position-absolute sequence-badge position-relative">
                {{sequence}}
            </span>
        {{/sequencerequired}}
        <div class="card-body">
            <h5 class="card-title">{{{fullname}}}</h5>
            <dl class="row">
                <dt class="col-6">
                    {{#str}}itempoints, enrol_programs{{/str}}
                </dt>
                <dd class="col-6">
                    {{points}}
                </dd>
                <dt class="col-6">
                    {{#str}}completiondelay, enrol_programs{{/str}}
                </dt>
                <dd class="col-6">
                    {{completiondelaytext}}
                    {{^completiondelaytext}}
                        {{#str}}notset, enrol_programs{{/str}}
                    {{/completiondelaytext}}
                </dd>
                {{#completioninfo}}
                    <dt class="col-6">
                        {{#str}}completiondate, enrol_programs{{/str}}
                    </dt>
                    <dd class="col-6">
                        {{.}}
                    </dd>
                {{/completioninfo}}
                {{^istraining}}
                    <dt class="col-6">
                        {{#str}}completion, enrol_programs{{/str}}
                    </dt>
                    <dd class="col-6">
                        {{#str}}completepercent, enrol_programs, <span>{{completionperct}}</span>{{/str}}
                    </dd>
                {{/istraining}}
                {{#istraining}}
                    <dt class="col-12">
                        {{completiontype}}
                    </dt>
                {{/istraining}}
            </dl>
        </div>
        <div class="card-footer">
            {{^disabled}}
                {{#detailurl}}
                    <a href="{{detailurl}}" class="btn btn-primary w-100">{{simplename}}</a>
                {{/detailurl}}
            {{/disabled}}
        </div>
    </div>
</div>